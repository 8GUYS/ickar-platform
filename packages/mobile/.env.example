# ─── ICKAR Mobile — Environment Variables ─────────────────────────────────────
# Copy to .env and fill in real values

# API base URL
# Dev (Android emulator): 10.0.2.2 maps to host machine's localhost
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Production (set after deploy)
# EXPO_PUBLIC_API_URL=https://api.ickar.ng

# Paystack public key (safe to expose — this is the PUBLIC key)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# App version
EXPO_PUBLIC_APP_VERSION=1.0.0
